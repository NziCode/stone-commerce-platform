* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# --- تنظیمات آمار زبان‌ها ---
# نادیده گرفتن فایل‌های بیلد شده و سنگین (برای حذف درصد کاذب CSS/JS)
public/css/*.css linguist-vendored
public/js/*.js linguist-vendored
public/build/** linguist-vendored
vendor/** linguist-vendored
node_modules/** linguist-vendored

# اگر همچنان CSS یا SCSS غیرعادی بالا بود، این دو خط را فعال کن:
# *.css linguist-vendored
# *.scss linguist-vendored

# نادیده گرفتن فایل‌های سیستمی و کش
storage/** linguist-vendored
bootstrap/cache/** linguist-vendored

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
